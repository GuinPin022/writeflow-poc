{
  "name": "writeflow-tracking-poc",
  "version": "0.1.0",
  "description": "POC de fiabilite du tracking d'ecriture dans Word (Office.js) pour WriteFlow / Strawords",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "typecheck": "tsc --noEmit",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "core-js": "^3.36.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "office-addin-debugging": "^5.1.6",
    "office-addin-dev-certs": "^1.13.4",
    "office-addin-manifest": "^1.13.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2"
  }
}
